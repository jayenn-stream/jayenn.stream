<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (heading + " · " + site.title) if heading else site.title %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{%- set ogSlug = (page.url | replace("/posts/", "") | replace("/", "")) if isPost else "site" %}
<meta property="og:image" content="{{ site.url }}/og/{{ ogSlug }}.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32.png">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#1b1d1f">
<link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{{ fonts | safe }}
<link rel="stylesheet" href="/assets/site.css">
<script type="application/ld+json">{{ jsonld | safe }}</script>
</head>
<body>
{{ content | safe }}
<nav class="bar" id="bar" aria-label="Main">
  <a href="/subjects/"{% if nav == "subjects" %} aria-current="page"{% endif %}>Subjects</a>
  <a href="/" data-posts{% if nav == "posts" %} aria-current="page"{% endif %}>Posts</a>
  <a href="/#here">Here?</a>
</nav>
<script src="/assets/site.js" defer></script>
</body>
</html>
